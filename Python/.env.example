# RetailChurn DWH orchestration configuration.
# Copy this file to `.env` and adjust the values for your environment.
# `.env` is ignored by Git so credentials are never committed.

# --- SQL Server connection ------------------------------------------------
# ODBC driver name as registered on the machine running this script.
DB_DRIVER=ODBC Driver 18 for SQL Server
# host\instance or host,port - for example: localhost\SQLEXPRESS
DB_SERVER=localhost
# The T-SQL scripts in DWH/RetailChurn/Source target this database name.
DB_NAME=RetailChurn
# Database used to create RetailChurn itself (layer 00).
DB_MASTER_DATABASE=master

# --- Authentication -------------------------------------------------------
# yes = Windows integrated authentication, no = SQL login below.
DB_TRUSTED_CONNECTION=yes
DB_USERNAME=
DB_PASSWORD=

# --- Transport ------------------------------------------------------------
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Timeouts (seconds, 0 = no query timeout) ----------------------------
DB_LOGIN_TIMEOUT=30
DB_QUERY_TIMEOUT=0

# --- Source data ----------------------------------------------------------
# Directory containing customer.csv, product.csv, order_items.csv and
# orders.csv. The staging layer BULK INSERTs these files, so the path must be
# readable by the SQL Server service account.
DATA_DIR=Data

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
