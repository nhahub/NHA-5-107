	measure 'Share of Total Returns %' =
			
			DIVIDE([Returned Orders], CALCULATE([Returned Orders], ALL(fact_orders[return_reason])), 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: COO\1
		lineageTag: 679880c0-841d-433b-9bd2-24f3ac876e36

	measure 'Segment Volume Share %' = ```
			
			DIVIDE(
			    [Total Orders], 
			    CALCULATE([Total Orders], REMOVEFILTERS(dim_customer[customer_segment])), 
			    0
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: CEO
		lineageTag: 8f30acf9-2c99-435e-aebf-089dfb1458f6

	measure 'Controllable Operational Failure Share %' = ```
			
			CALCULATE(
			    [Share of Total Returns %], 
			    fact_orders[return_reason] IN {
			        "Wrong Product", 
			        "Late Delivery", 
			        "Damaged Product", 
			        "Defective Product"
			    }
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: COO\1
		lineageTag: 36e73a32-ec11-494d-880d-1e1630495039

	measure 'SCAR Audit Trigger' =
			
			IF(
			    [Return Rate %] > 0.08,
			    "ISSUE SCAR & PAUSE PROCUREMENT (> 8.0% Return Rate)",
			    "Acceptable Vendor Quality"
			)
		displayFolder: COO\1
		lineageTag: 69bd6364-6147-4985-b05f-bed32a72de6d

	measure 'Expectation Mismatch Return %' = ```
			
			DIVIDE(
			    CALCULATE(
			        [Returned Orders], 
			        fact_orders[return_reason] IN {"Size Issue", "Changed Mind", "Product Not as Expected"}
			    ), 
			    [Returned Orders], 
			    0
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: COO\1
		lineageTag: ac386080-b8a5-4766-ba5e-60e8bcc07d1e

	measure 'Physical Transit Defect Return %' = ```
			
			DIVIDE(
			    CALCULATE(
			        [Returned Orders], 
			        fact_orders[return_reason] IN {"Damaged Product", "Defective Product", "Wrong Product"}
