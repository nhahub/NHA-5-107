	measure 'Negative Profit Order Share %' =
			
			VAR NegativeOrders = CALCULATE(DISTINCTCOUNT(fact_orders[order_key]), fact_orders[profit_local] < 0)
			VAR TotalOrdersCount = DISTINCTCOUNT(fact_orders[order_key])
			RETURN DIVIDE(NegativeOrders, TotalOrdersCount, 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: CFO\1
		lineageTag: a61c9a67-5051-4b07-a4b1-e209fe156cf5

