	measure 'Visual 1 Thresholds' =
			
			IF(
			    [Order #1 -> #2] >= 0.20 || [Order #2 -> #3] >= 0.20 || [Order #3 -> #4] >= 0.20 || [Order #4 -> #5] >= 0.20  || [Order #5+] >= 0.20 ,
			    "DEPLOY AUTOMATED REPLENISHMENT & ONBOARDING WORKFLOW",
			    "Standard Transition Sequences"
			)
		displayFolder: Customer Churn
		lineageTag: 3f9e5e41-003c-4d1b-89ac-329d2752cbd4

	measure 'At-Risk Customer Count' =
			
			CALCULATE(
			    SUM(dim_customer[Customer_Lifetime_Value]),
			    customer_summary[is_churned] = TRUE
			)
		formatString: 0
		displayFolder: Customer Churn
		lineageTag: a3534084-e12c-4608-8667-1056916965fa

	measure 'Segment At-Risk Equity Share %' =
			
			DIVIDE(
			    [At-Risk Customer Count],
			    CALCULATE(
			        [At-Risk Customer Count],
			        REMOVEFILTERS(dim_customer[customer_segment])
			    ),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customer Churn
		lineageTag: bb05bd53-b819-4500-89b7-7df16b35093a

	measure 'Customer Churn Probability %' =
			
			VAR TotalSegmentCustomers = DISTINCTCOUNT(fact_orders[customer_key])
			VAR ChurnedSegmentCustomers = CALCULATE(DISTINCTCOUNT(fact_orders[customer_key]), customer_summary[is_churned] = True)
			RETURN DIVIDE(ChurnedSegmentCustomers, TotalSegmentCustomers, 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customer Churn
		lineageTag: 120f170d-96c0-47aa-9e00-c89d32fce974

	measure 'Visual 3 thresholds' =
			
			IF(
			    SELECTEDVALUE(fact_orders[Delivery_Delay_Days]) >= 2,
			    ">= 2 Days SLA Breach",
			    "Standard Fulfillment"
			)
		displayFolder: Customer Churn
		lineageTag: 68185a92-c1df-4663-85d4-60d1184f7ad0

	measure 'Visual 4 Thresholds Churn' =
			
			IF(
			    [Profit Margin %] < 0.30,
			    "REJECT WIN-BACK OFFER (< 30% Corporate Floor)",
			    IF(
			        SELECTEDVALUE(fact_orders[Coupon_Tiers]) = "Zero-Discount Points Nudge",
			        "LEAD WIN-BACK WITH POINTS NUDGE (51.2% Margin)",
			        "Cap Discount at SAVE15 (Consumer) / SAVE25 (VIP)"
			    )
			)
		displayFolder: Customer Churn
		lineageTag: 29a46fd9-db36-4cab-852b-f69161843057

	measure 'Customer Cumulative Profit' =
			
			CALCULATE(
			    SUM(fact_orders[profit_local]),
			    ALLEXCEPT(dim_customer, dim_customer[customer_key])
			)
		formatString: 0
		displayFolder: Customer Churn\Visual 5
		lineageTag: 05b1f7cd-518b-45e7-a3fe-39ae462cee00

	measure 'Filters out unprofitable returners' = ```
			
			VAR IsChurnedVal = SELECTEDVALUE(customer_summary[is_churned])
			VAR SegmentVal   = SELECTEDVALUE(dim_customer[customer_segment])
			VAR ProfitVal    = [Customer Cumulative Profit]
			RETURN
			    IF(
			        IsChurnedVal = TRUE 
			        && SegmentVal IN {"VIP", "Premium"} 
			        && ProfitVal > 0,
			        1,
			        0
			    )
			```
		formatString: 0
		displayFolder: Customer Churn\Visual 5
		lineageTag: 10834598-79d3-45d7-bb75-6b30a740844d

	measure 'Top At-Risk VIP & Premium Account CLV ($)' =
			
			IF(
			    [Filters out unprofitable returners] = 1,
			    SUM(dim_customer[Customer_Lifetime_Value]),
			    BLANK()
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Customer Churn\Visual 5
		lineageTag: 07533c08-e652-42c2-a7ef-895df909aeb5

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Monday CRM Outreach Rank' =
			
			IF(
			    [Filters out unprofitable returners] = 1,
			    RANKX(
			        FILTER(
			            ALL(dim_customer),
			            [Filters out unprofitable returners] = 1
			        ),
			        CALCULATE(SUM(dim_customer[Customer_Lifetime_Value])),
			        ,
			        DESC
			    ),
			    BLANK()
			)
		formatString: 0
		displayFolder: Customer Churn\Visual 5
		lineageTag: c701b09a-6864-4206-9a0b-14d5b8299bf7

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_ResultType = Table

