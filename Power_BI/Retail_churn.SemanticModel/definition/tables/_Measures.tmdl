	measure 'Order #1 -> #2' =
			
			VAR Order1Count = CALCULATE(DISTINCTCOUNT(fact_orders[customer_key]), fact_orders[order_sequence] >= 1)
			VAR Order2Count = CALCULATE(DISTINCTCOUNT(fact_orders[customer_key]), fact_orders[order_sequence] >= 2)
			RETURN DIVIDE(Order1Count - Order2Count, Order1Count, 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customer Churn
		lineageTag: 6aff9533-5e14-49bc-80f4-31cf6dcef848

