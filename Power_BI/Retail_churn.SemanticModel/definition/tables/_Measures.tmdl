	measure 'Positive Review Share %' = ```
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(fact_orders), 
			        fact_orders[review_sentiment] = "Positive"
			    ),
			    CALCULATE(
			        COUNTROWS(fact_orders),
			        REMOVEFILTERS(fact_orders[review_sentiment]),
			        NOT ISBLANK(fact_orders[review_sentiment])
			    ),
			    0
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: COO\1
		lineageTag: ae8a69d6-2a5e-46ab-a0a2-f40abb27cc1d

	measure 'Negative Review Share %' = ```
			
