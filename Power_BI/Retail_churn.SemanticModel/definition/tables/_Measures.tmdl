	measure 'YoY Growth %' = ```
			
			VAR CurrentPeriodSales = [Total Net Sales]
			VAR PriorPeriodSales = 
			    CALCULATE(
			        [Total Net Sales],
			        SAMEPERIODLASTYEAR('Calendar'[Date])
			    )
			RETURN
			    DIVIDE(
			        CurrentPeriodSales - PriorPeriodSales,
			        PriorPeriodSales,
			        0
			    )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Financial Metrics
		lineageTag: cf30e159-4604-48e2-93e0-3fabcf4dc006

	measure 'Average CAC' = AVERAGE(dim_customer[customer_acquisition_cost])
