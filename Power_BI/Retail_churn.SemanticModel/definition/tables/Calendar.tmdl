table Calendar
	lineageTag: 043d1bec-ef5f-4b34-b12c-4d35f564476c
	dataCategory: Time

	column Date
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 850b468d-867d-4d12-aac8-180ea81739dc
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column Year
		formatString: 0
		lineageTag: 2da82c3f-54d8-4a5e-9227-e4c0e111f9f9
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		formatString: 0
		lineageTag: 602afc70-274a-48dd-8e0e-bbc918c28b99
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = Automatic

	column 'Month Name'
		lineageTag: eb62edcc-5feb-4e5d-a5ea-c2ba712b9710
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Name]
		sortByColumn: 'Month Number'

		annotation SummarizationSetBy = Automatic

	column 'Month Short'
		lineageTag: 164e2b9c-06d0-4075-a171-a223f4bf9b00
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Short]

		annotation SummarizationSetBy = Automatic

	column Quarter
		lineageTag: ea32e572-b439-46c5-a711-5e31024a0d78
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	column 'Day Number'
		formatString: 0
		lineageTag: b026acb5-b281-4024-87a5-57f0099fd427
		summarizeBy: none
		isNameInferred
		sourceColumn: [Day Number]

		annotation SummarizationSetBy = Automatic

	column 'Day Name'
		lineageTag: e9e1930d-193f-4ee8-8973-0c3d960e264a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Day Name]

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2021, 1, 1), DATE(2025, 12, 31)),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Month Short", FORMAT([Date], "MMM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Day Number", WEEKDAY([Date], 2), -- 1 (Monday) to 7 (Sunday)
				    "Day Name", FORMAT([Date], "dddd")
				)

	annotation PBI_Id = f8890583da61447fa059879cf62359e6

