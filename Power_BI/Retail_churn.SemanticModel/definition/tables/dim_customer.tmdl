	column customer_acquisition_cost
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 079084ea-ee00-4764-8b3f-c43342ad9a85
		summarizeBy: none
		sourceColumn: customer_acquisition_cost

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column Customer_Lifetime_Value =
			
			CALCULATE(
			    SUM(fact_order_items[net_sales_local])
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 72bb9ba5-d942-4a98-bc41-ea6a3ec3f161
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column Customer_Lifetime_Tier =
			
			SWITCH(
			    TRUE(),
			    dim_customer[Customer_Lifetime_Value] >= 15000, "VIP",
			    dim_customer[Customer_Lifetime_Value] >= 5000,  "Premium",
			    dim_customer[Customer_Lifetime_Value] >= 1000,  "Regular",
			    "Low-Value"
			)
		lineageTag: 669cba5c-7e32-435c-a329-cea06366d00f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

