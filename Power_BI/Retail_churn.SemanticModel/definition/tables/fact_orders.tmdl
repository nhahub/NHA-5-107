	partition fact_orders = m
		mode: import
		source = ```
				let
				  Source = Sql.Database("localhost\SQLEXPRESS", "RetailChurn"),
				  #"Navigation 1" = Source{[Schema = "gold", Item = "fact_orders"]}[Data],
				  #"Removed columns" = Table.RemoveColumns(#"Navigation 1", {"gold_created_at", "order_id", "profit_margin_percentage"}),
				
				  // Convert integer date_key (e.g., 20221026) to a real Date
				  #"Converted date_key to Date" = Table.TransformColumns(
				      #"Removed columns", 
				      {{"date_key", each if _ <> null then Date.FromText(Text.From(_)) else null, type date}}
				  ),
				
				  #"Changed column type" = Table.TransformColumnTypes(
				      #"Converted date_key to Date", 
				      {
				          {"discount_amount", Currency.Type}, 
				          {"tax_amount", Currency.Type}, 
				          {"shipping_cost", Currency.Type}, 
				          {"gross_sales", Currency.Type}, 
				          {"net_sales", Currency.Type}, 
				          {"product_cost", Currency.Type}, 
				          {"profit", Currency.Type}
				      }
				  ),
				
				  // Group by customer_key, sort by date and order_key, then add sequence index
				  #"Grouped By Customer" = Table.Group(#"Changed column type", {"customer_key"}, {
				      "CustomerData", each Table.AddIndexColumn(
				          Table.Sort(_, {{"date_key", Order.Ascending}, {"order_key", Order.Ascending}}), 
				          "order_sequence", 
				          1, 
				          1, 
				          Int64.Type
				      )
				  }),
				
				  // Define exact list of inner columns to expand
				  ColumnsToExpand = List.RemoveItems(Table.ColumnNames(#"Changed column type"), {"customer_key"}) & {"order_sequence"},
				
				  #"Expanded CustomerData" = Table.ExpandTableColumn(
				      #"Grouped By Customer", 
				      "CustomerData", 
				      ColumnsToExpand
				  ),
				  
				  #"Changed column type 1" = Table.TransformColumnTypes(
				      #"Expanded CustomerData", 
				      {
				          {"order_sequence", Int64.Type}, 
				          {"delivery_days", Int64.Type}, 
				          {"estimated_delivery_days", Int64.Type}, 
				          {"delivery_delay_days", Int64.Type}
				      }
				  ),
				
				  // 1. discount_percentage: DIVIDE(discount_amount, gross_sales, 0)
				  #"Added Discount_Percentage" = Table.AddColumn(
				      #"Changed column type 1", 
				      "discount_percentage", 
				      each let
				          discAmt = if [discount_amount] = null then 0 else Number.From([discount_amount]),
				          gross = if [gross_sales] = null then 0 else Number.From([gross_sales])
				      in
				          if gross > 0 then discAmt / gross else 0,
				      Percentage.Type
				  ),
				
				  // 2. Win_Back_Offer_Tier
				  #"Added Coupon_Tiers" = Table.AddColumn(
				      #"Added Discount_Percentage", 
				      "Coupon_Tiers", 
				      each let
				          disc = if [discount_percentage] = null then 0 else Number.From([discount_percentage]),
				          code = if [coupon_code] = null then "" else Text.Upper(Text.Trim(Text.From([coupon_code])))
				      in
				          if disc = 0 or code = "" or List.Contains({"NONE", "POINTS NUDGE", "ZERO-DISCOUNT POINTS NUDGE"}, code) 
				              then "Zero-Discount"
				          else if disc <= 0.15 
				              then "SAVE15"
				          else if disc <= 0.25 
				              then "SAVE25"
				          else 
				              "SAVE35+ Coupon",
				      type text
				  ),
				
				  // 3. Win_Back_Offer_Sort
				  #"Added Coupon_Sort" = Table.AddColumn(
				      #"Added Coupon_Tiers", 
				      "Coupon_Sort", 
				      each if [Coupon_Tiers] = "Zero-Discount" then 1
				      else if [Coupon_Tiers] = "SAVE15" then 2
				      else if [Coupon_Tiers] = "SAVE25" then 3
				      else if [Coupon_Tiers] = "SAVE35+ Coupon" then 4
				      else 5,
				      Int64.Type
				  ),
				
				  // 4. Delay_Status_Tier (Handles null/unfulfilled dispatches)
				  #"Added Delay_Status_Tier" = Table.AddColumn(
				      #"Added Coupon_Sort", 
				      "Delay_Status_Tier", 
				      each if [delivery_delay_days] = null then "Unfulfilled"
				      else if [delivery_delay_days] <= 0 then "On-Time / Early"
				      else if [delivery_delay_days] = 1 then "1 Day Late"
				      else if [delivery_delay_days] = 2 then "2 Days Late"
				      else "3+ Days Late",
				      type text
				  ),
				
				  // 5. Discount Tiers (0-10%, 10-20%, 20-30%, 30-40%, 40%+)
				  #"Added Discount_Tiers" = Table.AddColumn(
				      #"Added Delay_Status_Tier", 
				      "Discount Tiers", 
				      each let
				          disc = if [discount_percentage] = null then 0 else Number.From([discount_percentage])
				      in
				          if disc <= 0.10 then "0-10%"
				          else if disc <= 0.20 then "10-20%"
				          else if disc <= 0.30 then "20-30%"
				          else if disc <= 0.40 then "30-40%"
				          else "40%+",
				      type text
				  ),
				
				  // 6. Discount Tier Sort (Sort column for Discount Tiers axis)
				  #"Added Discount_Tier_Sort" = Table.AddColumn(
				      #"Added Discount_Tiers", 
				      "Discount Tier Sort", 
				      each let
				          disc = if [discount_percentage] = null then 0 else Number.From([discount_percentage])
				      in
				          if disc <= 0.10 then 1
				          else if disc <= 0.20 then 2
				          else if disc <= 0.30 then 3
				          else if disc <= 0.40 then 4
				          else 5,
				      Int64.Type
				  ),
				
				  // 7. Purchase_Label (Order #1 to Order #10+)
				  #"Added Purchase_Label" = Table.AddColumn(
				      #"Added Discount_Tier_Sort", 
				      "Purchase_Label", 
				      each if [order_sequence] = null then null
				      else if [order_sequence] >= 10 then "Order #10+"
				      else "Order #" & Text.From([order_sequence]),
				      type text
				  ),
				  #"Added custom" = Table.TransformColumnTypes(Table.AddColumn(#"Added Purchase_Label", "YearMonth", each Date.Year([date_key]) * 100 + Date.Month([date_key])), {{"YearMonth", Int64.Type}}),
				  #"Merged queries" = Table.NestedJoin(#"Added custom", {"currency", "YearMonth"}, dim_exchange_rates, {"currency", "YearMonth"}, "dim_exchange_rates", JoinKind.LeftOuter),
				  #"Expanded dim_exchange_rates" = Table.ExpandTableColumn(#"Merged queries", "dim_exchange_rates", {"currency", "YearMonth", "Year", "Month", "usd_multiplier"}, {"currency.1", "YearMonth.1", "Year", "Month", "usd_multiplier"}),
				  #"Removed columns 1" = Table.RemoveColumns(#"Expanded dim_exchange_rates", {"currency.1", "YearMonth.1", "Year", "Month"}),
				
				  #"Renamed Local Columns" = Table.RenameColumns(
				      #"Removed columns 1", // Replace with your actual previous step name
				      {
				          {"gross_sales", "gross_sales_local"},
				          {"discount_amount", "discount_amount_local"},
				          {"tax_amount", "tax_amount_local"},
				          {"shipping_cost", "shipping_cost_local"},
				          {"net_sales", "net_sales_local"},
				          {"product_cost", "product_cost_local"},
				          {"profit", "profit_local"}
				      }
				  ),
				  // 3. Create USD-normalized columns using the ORIGINAL column names
				  #"Added USD gross_sales" = Table.AddColumn(#"Renamed Local Columns", "gross_sales", each [gross_sales_local] * [usd_multiplier], Currency.Type),
				  #"Added USD discount_amount" = Table.AddColumn(#"Added USD gross_sales", "discount_amount", each [discount_amount_local] * [usd_multiplier], Currency.Type),
				  #"Added USD tax_amount" = Table.AddColumn(#"Added USD discount_amount", "tax_amount", each [tax_amount_local] * [usd_multiplier], Currency.Type),
				  #"Added USD shipping_cost" = Table.AddColumn(#"Added USD tax_amount", "shipping_cost", each [shipping_cost_local] * [usd_multiplier], Currency.Type),
				  #"Added USD net_sales" = Table.AddColumn(#"Added USD shipping_cost", "net_sales", each [net_sales_local] * [usd_multiplier], Currency.Type),
				  #"Added USD product_cost" = Table.AddColumn(#"Added USD net_sales", "product_cost", each [product_cost_local] * [usd_multiplier], Currency.Type),
				  #"Added USD profit" = Table.AddColumn(#"Added USD product_cost", "profit", each [profit_local] * [usd_multiplier], Currency.Type)
				
				in
				  #"Added USD profit"
				```

	annotation PBI_ResultType = Table

