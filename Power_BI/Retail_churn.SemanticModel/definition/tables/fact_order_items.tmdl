	partition fact_order_items = m
		mode: import
		source = ```
				let
				  Source = Sql.Database("localhost\SQLEXPRESS", "RetailChurn"),
				  #"Navigation 1" = Source{[Schema = "gold", Item = "fact_order_items"]}[Data],
				
				  // 1. Remove metadata columns (keeping order_id temporarily to lookup currency from fact_orders)
				  #"Removed columns" = Table.RemoveColumns(#"Navigation 1", {"gold_created_at", "is_quantity_corrected", "is_net_sales_corrected"}),
				
				  // 2. Set initial column types
				  #"Changed column type" = Table.TransformColumnTypes(#"Removed columns", {
				      {"unit_price", Currency.Type}, 
				      {"discount_percentage", Percentage.Type}, 
				      {"gross_sales", Currency.Type}, 
				      {"tax_amount", Currency.Type}, 
				      {"shipping_cost", Currency.Type}, 
				      {"net_sales", Currency.Type}, 
				      {"product_cost", Currency.Type}, 
				      {"profit", Currency.Type}, 
				      {"discount_amount", Currency.Type}
				  }),
				
				  // 3. Convert integer date_key to a real Date
				  #"Converted date_key to Date" = Table.TransformColumns(
				      #"Changed column type", 
				      {{"date_key", each if _ <> null then Date.FromText(Text.From(_)) else null, type date}}
				  ),
				
				  // 4. Merge fact_orders to retrieve currency code
				  #"Merged fact_orders" = Table.NestedJoin(
				      #"Converted date_key to Date", 
				      {"order_id"}, 
				      Source{[Schema = "gold", Item = "fact_orders"]}[Data], 
				      {"order_id"}, 
				      "OrderHeader", 
				      JoinKind.LeftOuter
				  ),
				
				  // 5. Expand currency from fact_orders
				  #"Expanded currency" = Table.ExpandTableColumn(
				      #"Merged fact_orders", 
				      "OrderHeader", 
				      {"currency"}, 
				      {"currency"}
				  ),
				
				  // 6. Create YearMonth Key (e.g., 202210) from date_key for FX lookup
				  #"Added YearMonth Key" = Table.AddColumn(
				      #"Expanded currency", 
				      "YearMonth", 
				      each if [date_key] <> null then Date.Year([date_key]) * 100 + Date.Month([date_key]) else null, 
				      Int64.Type
				  ),
				
				  // 7. Merge with dim_exchange_rates table on {currency, YearMonth}
				  #"Merged dim_exchange_rates" = Table.NestedJoin(
				      #"Added YearMonth Key", 
				      {"currency", "YearMonth"}, 
				      dim_exchange_rates, 
				      {"currency", "YearMonth"}, 
				      "FX_Lookup", 
				      JoinKind.LeftOuter
				  ),
				
				  // 8. Expand usd_multiplier
				  #"Expanded FX_Lookup" = Table.ExpandTableColumn(
				      #"Merged dim_exchange_rates", 
				      "FX_Lookup", 
				      {"usd_multiplier"}
				  ),
				
				  // 9. Clean usd_multiplier (Defaults to 1.0 for USD or nulls)
				  #"Cleaned usd_multiplier" = Table.AddColumn(
				      #"Expanded FX_Lookup", 
				      "usd_multiplier_clean", 
				      each if [currency] = "USD" or [usd_multiplier] = null or [usd_multiplier] = 0 then 1.0 else Number.From([usd_multiplier]),
				      type number
				  ),
				
				  // 10. Rename local line-item monetary columns to *_local
				  #"Renamed Local Columns" = Table.RenameColumns(
				      #"Cleaned usd_multiplier", 
				      {
				          {"unit_price", "unit_price_local"},
				          {"gross_sales", "gross_sales_local"},
				          {"discount_amount", "discount_amount_local"},
				          {"tax_amount", "tax_amount_local"},
				          {"shipping_cost", "shipping_cost_local"},
				          {"net_sales", "net_sales_local"},
				          {"product_cost", "product_cost_local"},
				          {"profit", "profit_local"}
				      }
				  ),
				
				  // 11. Recreate USD-Normalized financial columns using ORIGINAL column names
				  #"Added USD unit_price" = Table.AddColumn(#"Renamed Local Columns", "unit_price", each [unit_price_local] * [usd_multiplier_clean], Currency.Type),
				  #"Added USD gross_sales" = Table.AddColumn(#"Added USD unit_price", "gross_sales", each [gross_sales_local] * [usd_multiplier_clean], Currency.Type),
				  #"Added USD discount_amount" = Table.AddColumn(#"Added USD gross_sales", "discount_amount", each [discount_amount_local] * [usd_multiplier_clean], Currency.Type),
				  #"Added USD tax_amount" = Table.AddColumn(#"Added USD discount_amount", "tax_amount", each [tax_amount_local] * [usd_multiplier_clean], Currency.Type),
				  #"Added USD shipping_cost" = Table.AddColumn(#"Added USD tax_amount", "shipping_cost", each [shipping_cost_local] * [usd_multiplier_clean], Currency.Type),
				  #"Added USD net_sales" = Table.AddColumn(#"Added USD shipping_cost", "net_sales", each [net_sales_local] * [usd_multiplier_clean], Currency.Type),
				  #"Added USD product_cost" = Table.AddColumn(#"Added USD net_sales", "product_cost", each [product_cost_local] * [usd_multiplier_clean], Currency.Type),
				  #"Added USD profit" = Table.AddColumn(#"Added USD product_cost", "profit", each [profit_local] * [usd_multiplier_clean], Currency.Type),
				
				  // 13. Remove order_id and temporary helper lookup columns
				  #"Final Cleaned Columns" = Table.RemoveColumns(
				      #"Added USD profit", 
				      {"order_id", "currency", "YearMonth", "usd_multiplier", "usd_multiplier_clean"}
				  )
				in
				  #"Final Cleaned Columns"
				```

	annotation PBI_ResultType = Table

